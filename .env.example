# Yandex Maps JavaScript API 2.1 key. The app shows setup guidance when absent.
YANDEX_MAPS_API_KEY=

APP_HOST=127.0.0.1
APP_PORT=8000
OPEN_BROWSER=1
APP_DATA_DIR=data

# Offline deterministic parser for demonstrations and E2E verification.
PARSER_DEMO_MODE=0

# Keep Selenium Chromium in the background so parsing stays inside the web-app workflow.
PARSER_HEADLESS=1

# Maximum number of concurrent parsing jobs (each spawns a Chromium instance).
MAX_CONCURRENT_JOBS=2

# Automatically delete completed jobs older than N days on application startup.
MAX_JOB_AGE_DAYS=30
